<Page
    x:Class="_4PDA.TopicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PageNavigationButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource PdaTextBrush}" />
        </Style>
        <Style x:Key="PostMenuIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="TopicRootGrid" Background="{ThemeResource PdaPageBackgroundBrush}">
        <ListView x:Name="PostsListView" Background="Transparent" Padding="0,4,0,6" HorizontalContentAlignment="Stretch"
                  SelectionMode="None" IsItemClickEnabled="False"
                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Loaded="PostsListView_Loaded" SizeChanged="PostsListView_SizeChanged"
                  ContainerContentChanging="PostsListView_ContainerContentChanging">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate><Border MinHeight="80" /></DataTemplate></ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel HorizontalAlignment="Stretch">
                    <Grid x:Name="InfiniteScrollFooter" Height="56">
                        <ProgressRing x:Name="LoadMoreRing" Width="30" Height="30" IsActive="False" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Border x:Name="PaginationBar" Visibility="Collapsed"
                            Background="{ThemeResource PdaSurfaceBrush}" BorderBrush="{ThemeResource PdaSelectedBrush}" BorderThickness="0,1,0,0">
                        <Grid MaxWidth="680" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18*" /><ColumnDefinition Width="18*" />
                                <ColumnDefinition Width="28*" />
                                <ColumnDefinition Width="18*" /><ColumnDefinition Width="18*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FirstPageButton" Grid.Column="0" Content="&lt;&lt;" Style="{StaticResource PageNavigationButtonStyle}"
                                    AutomationProperties.Name="Первая страница" Click="FirstPageButton_Click" />
                            <Button x:Name="PreviousPageButton" Grid.Column="1" Content="&lt;" Style="{StaticResource PageNavigationButtonStyle}"
                                    AutomationProperties.Name="Предыдущая страница" Click="PreviousPageButton_Click" />
                            <Button x:Name="PageNumberButton" Grid.Column="2" Content="1/1" FontSize="14" Style="{StaticResource PageNavigationButtonStyle}"
                                    AutomationProperties.Name="Выбрать страницу">
                                <Button.Flyout>
                                    <Flyout x:Name="PageNumberFlyout" Opened="PageNumberFlyout_Opened">
                                        <StackPanel Width="220">
                                            <TextBlock x:Name="PageRangeText" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <TextBox x:Name="PageNumberTextBox" MaxLength="10" AutomationProperties.Name="Номер страницы"
                                                     TextChanged="PageNumberTextBox_TextChanged" KeyDown="PageNumberTextBox_KeyDown">
                                                <TextBox.InputScope><InputScope><InputScope.Names><InputScopeName NameValue="Number" /></InputScope.Names></InputScope></TextBox.InputScope>
                                            </TextBox>
                                            <Button x:Name="GoToPageButton" Content="Перейти" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                                    Click="GoToPageButton_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="NextPageButton" Grid.Column="3" Content="&gt;" Style="{StaticResource PageNavigationButtonStyle}"
                                    AutomationProperties.Name="Следующая страница" Click="NextPageButton_Click" />
                            <Button x:Name="LastPageButton" Grid.Column="4" Content="&gt;&gt;" Style="{StaticResource PageNavigationButtonStyle}"
                                    AutomationProperties.Name="Последняя страница" Click="LastPageButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <Button x:Name="ScrollJumpButton" Width="44" Height="44" MinWidth="0" Margin="0,0,12,12"
                Visibility="Collapsed" Opacity="0" IsTabStop="False" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#FF303030" BorderBrush="#FF808080" BorderThickness="1" Foreground="#FFE0E0E0"
                AutomationProperties.Name="В начало списка" Click="ScrollJumpButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <FontIcon x:Name="ScrollJumpIcon" Glyph="&#xE74A;" FontSize="20" Foreground="#FFE0E0E0" />
        </Button>

        <ProgressRing x:Name="LoadingRing"
                      Width="44"
                      Height="44"
                      IsActive="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

        <TextBlock x:Name="EmptyTextBlock"
                   Visibility="Collapsed"
                   Text="&#x0422;&#x0435;&#x043C;&#x0430; &#x043D;&#x0435; &#x0437;&#x0430;&#x0433;&#x0440;&#x0443;&#x0436;&#x0435;&#x043D;&#x0430;"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="24"
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{ThemeResource PdaSecondaryTextBrush}" />

        <Popup x:Name="DownloadOverlayPopup"
               IsLightDismissEnabled="False">
            <Grid x:Name="DownloadOverlay"
                  Background="#B3000000"
                  IsHitTestVisible="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="DownloadOverlayContent"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="440"
                            MaxWidth="440"
                            Margin="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DownloadTitleTextBlock"
                               Text="Загрузка файла"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextAlignment="Center" />

                    <TextBlock x:Name="DownloadFileTextBlock"
                               Margin="0,10,0,18"
                               Foreground="#FFD0D0D0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <ProgressBar x:Name="DownloadProgressBar"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Background="#55FFFFFF"
                                 Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                 IsIndeterminate="True" />

                    <TextBlock x:Name="DownloadProgressTextBlock"
                               Margin="0,12,0,0"
                               Foreground="White"
                               Text="Подключаемся..."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Popup>
    </Grid>
</Page>
