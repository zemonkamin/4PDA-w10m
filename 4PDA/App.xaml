<Application
    x:Class="_4PDA.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:_4PDA">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PdaPageBackgroundBrush" Color="#111310" />
                    <SolidColorBrush x:Key="PdaSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PdaTextBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="PdaSecondaryTextBrush" Color="#FF777777" />
                    <SolidColorBrush x:Key="PdaTertiaryTextBrush" Color="#FFA5A5A5" />
                    <SolidColorBrush x:Key="PdaSelectedBrush" Color="#FFEFEFEF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PdaPageBackgroundBrush" Color="#111310" />
                    <SolidColorBrush x:Key="PdaSurfaceBrush" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="PdaTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PdaSecondaryTextBrush" Color="#FFCFCFCF" />
                    <SolidColorBrush x:Key="PdaTertiaryTextBrush" Color="#FF9A9A9A" />
                    <SolidColorBrush x:Key="PdaSelectedBrush" Color="#FF3A3A3A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PdaPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PdaSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PdaTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PdaSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PdaTertiaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PdaSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
