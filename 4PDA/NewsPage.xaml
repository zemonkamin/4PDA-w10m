<Page
    x:Class="_4PDA.NewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:images="using:_4PDA.Services"
    xmlns:models="using:_4PDA.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource PdaPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="12,8">
            <TextBlock x:Name="StatusTextBlock"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource PdaSecondaryTextBrush}" />
            <Button Content="Повторить загрузку" Click="RetryButton_Click" Margin="0,6,0,0" />
        </StackPanel>
        <GridView x:Name="NewsGridView"
                  Grid.Row="1"
                  Padding="8"
                  IsItemClickEnabled="True"
                  IsSwipeEnabled="False"
                  SelectionMode="None"
                  ShowsScrollingPlaceholders="True"
                  ContainerContentChanging="NewsGridView_ContainerContentChanging"
                  Loaded="NewsGridView_Loaded"
                  SizeChanged="NewsGridView_SizeChanged"
                  ItemClick="NewsGridView_ItemClick">
            <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" CacheLength="0.25" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:NewsItem">
                    <Grid x:Name="CardRoot"
                          Margin="0,0,0,8"
                          Background="{ThemeResource PdaSurfaceBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="54" />
                            <RowDefinition Height="41" />
                            <RowDefinition Height="13" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <Border x:Name="CardImageHost"
                                Tag="NewsCardImageHost"
                                Grid.Row="0"
                                Background="{ThemeResource PdaPageBackgroundBrush}">
                            <Image x:Name="CardImage"
                                   Tag="NewsCardImage"
                                   x:Phase="2"
                                   images:DeferredImage.Url="{x:Bind ImageUrl, Mode=OneWay}"
                                   images:DeferredImage.DecodeWidth="420"
                                   Visibility="{x:Bind ImageVisibility}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind Title}"
                                   Margin="12,10,12,0"
                                   FontSize="18" LineHeight="22"
                                   FontWeight="SemiBold"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource PdaTextBrush}" />

                        <TextBlock Grid.Row="2" x:Phase="1"
                                   Text="{x:Bind Description}"
                                   Margin="12,5,12,0"
                                   FontSize="13" LineHeight="18"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource PdaSecondaryTextBrush}" />

                        <Grid Grid.Row="4"
                              Margin="12,7,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Date}" x:Phase="1"
                                       FontSize="11"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Author}" x:Phase="1"
                                       FontSize="11"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="  &#xE90A; "
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                            <TextBlock Grid.Column="4"
                                       Text="{x:Bind CommentsText}" x:Phase="1"
                                       FontSize="11"
                                       Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="1"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

        <TextBlock x:Name="EmptyTextBlock"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   Text="&#x041D;&#x043E;&#x0432;&#x043E;&#x0441;&#x0442;&#x0438; &#x043D;&#x0435; &#x0437;&#x0430;&#x0433;&#x0440;&#x0443;&#x0436;&#x0435;&#x043D;&#x044B;"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Margin="16"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{ThemeResource PdaSecondaryTextBrush}" />
    </Grid>
</Page>
