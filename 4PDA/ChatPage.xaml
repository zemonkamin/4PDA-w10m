<Page
    x:Class="_4PDA.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:images="using:_4PDA.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ChatListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChatImageTemplate">
            <Border Margin="0,8,0,0"
                    Background="{ThemeResource PdaSurfaceBrush}"
                    BorderBrush="{ThemeResource PdaSelectedBrush}"
                    BorderThickness="1"
                    >
                <Image images:DeferredImage.Url="{Binding Url}"
                       Tapped="ChatPhoto_Tapped"
                       images:DeferredImage.DecodeWidth="480"
                       MinHeight="100"
                       MinWidth="100"
                       Stretch="Uniform"
                       MaxHeight="320"
                       HorizontalAlignment="Left" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate">
            <StackPanel Margin="10,0,10,10">
                <Grid Margin="4,9,4,10"
                      Visibility="{Binding DateSeparatorVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="1"
                            Margin="0,0,9,0"
                            Background="{ThemeResource PdaSelectedBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DaySeparatorText}"
                               FontSize="12"
                               Foreground="{ThemeResource PdaTertiaryTextBrush}"
                               HorizontalAlignment="Center" />
                    <Border Grid.Column="2"
                            Height="1"
                            Margin="9,0,0,0"
                            Background="{ThemeResource PdaSelectedBrush}"
                            VerticalAlignment="Center" />
                </Grid>

                <Border MaxWidth="760"
                        Padding="12,9,10,6"
                        CornerRadius="0"
                        Background="{Binding BubbleBrush}"
                        HorizontalAlignment="{Binding BubbleAlignment}">
                    <StackPanel>
                        <TextBlock Text="{Binding Text}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource PdaTextBrush}" />

                        <ItemsControl ItemsSource="{Binding Images}"
                                      ItemTemplate="{StaticResource ChatImageTemplate}" />

                        <TextBlock Text="{Binding TimeText}"
                                   Visibility="{Binding TimeVisibility}"
                                   Margin="18,5,0,0"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource PdaPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ListView x:Name="MessagesListView"
                      Padding="0,8,0,4"
                      Background="Transparent"
                      ItemTemplate="{StaticResource MessageTemplate}"
                      ItemContainerStyle="{StaticResource ChatListViewItemStyle}"
                      SelectionMode="None">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
            </ListView>

            <ProgressRing x:Name="ChatProgressRing"
                          Width="54"
                          Height="54"
                          IsActive="False"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <TextBlock x:Name="EmptyTextBlock"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="28"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource PdaSecondaryTextBrush}" />
        </Grid>

        <TextBlock x:Name="ChatStatusTextBlock"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   Margin="12,5,12,5"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource PdaSecondaryTextBrush}" />

        <Border Grid.Row="2"
                Padding="8"
                Background="{ThemeResource PdaSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox"
                         Grid.Column="0"
                         MinHeight="44"
                         MaxHeight="130"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Сообщение" />

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        MinWidth="104"
                        Height="44"
                        Margin="8,0,0,0"
                        Content="Отправить"
                        Click="SendButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
