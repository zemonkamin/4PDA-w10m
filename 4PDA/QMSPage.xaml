<Page
    x:Class="_4PDA.QMSPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:images="using:_4PDA.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="QmsListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ListViewItemPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="0"
                            Margin="0"
                            SelectedBackground="{ThemeResource PdaSelectedBrush}"
                            SelectedForeground="{ThemeResource PdaTextBrush}"
                            PointerOverBackground="{ThemeResource PdaSelectedBrush}"
                            PressedBackground="{ThemeResource PdaSelectedBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="QmsNodeTemplate">
            <Grid MinHeight="68"
                  Margin="{Binding RowMargin}"
                  Padding="0"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="3"
                        Margin="42,0,12,0"
                        BorderBrush="{ThemeResource PdaSelectedBrush}"
                        BorderThickness="0,0,0,1" />

                <Border Grid.Column="0"
                        Tag="{Binding}"
                        Background="Transparent"
                        Tapped="QmsArrow_Tapped">
                    <TextBlock Text="{Binding ExpandButtonText}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="20"
                               Opacity="{Binding ExpandButtonOpacity}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource PdaSecondaryTextBrush}" />
                </Border>

                <Grid Grid.Column="1"
                      Width="44"
                      Height="44"
                      Margin="0,12,8,12">
                    <Border Background="{ThemeResource PdaSelectedBrush}" />
                    <TextBlock Text="{Binding IconText}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource PdaSecondaryTextBrush}" />
                    <Image images:DeferredImage.Url="{Binding AvatarUrl}"
                           images:DeferredImage.DecodeWidth="88"
                           Stretch="UniformToFill"
                           Visibility="{Binding AvatarVisibility}"
                           ImageFailed="AvatarImage_ImageFailed" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Margin="0,9,14,9"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{Binding TitleFontSize}"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource PdaTextBrush}" />
                    <TextBlock Text="{Binding Subtitle}"
                               Margin="0,3,0,0"
                               FontSize="13"
                               MaxLines="1"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource PdaSecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource PdaPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ListView x:Name="QmsListView"
                      Padding="0,0,0,10"
                      Background="Transparent"
                      ItemTemplate="{StaticResource QmsNodeTemplate}"
                      ItemContainerStyle="{StaticResource QmsListViewItemStyle}"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="QmsListView_ItemClick">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
            </ListView>

            <ProgressRing x:Name="QmsProgressRing"
                          Width="52"
                          Height="52"
                          IsActive="False"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <TextBlock x:Name="QmsEmptyTextBlock"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="28"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource PdaSecondaryTextBrush}" />
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   Margin="16,6,16,10"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource PdaSecondaryTextBrush}" />
    </Grid>
</Page>
