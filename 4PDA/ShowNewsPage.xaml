<Page
    x:Class="_4PDA.ShowNewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource PdaPageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Background="{ThemeResource PdaSurfaceBrush}">
                <Image x:Name="ArticleImage"
                       MaxHeight="360"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch" />
                <TextBlock x:Name="TitleTextBlock"
                           Margin="16,14,16,0"
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource PdaTextBrush}" />
                <StackPanel Margin="16,10,16,8"
                            Orientation="Horizontal">
                    <TextBlock x:Name="DateTextBlock"
                               FontSize="12"
                               Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                    <TextBlock Text="  "
                               FontSize="12" />
                    <TextBlock x:Name="AuthorTextBlock"
                               FontSize="12"
                               Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                    <TextBlock Text="  &#xE90A; "
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                    <TextBlock x:Name="CommentsTextBlock"
                               FontSize="12"
                               Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="ArticleStatusTextBlock"
                           Visibility="Collapsed"
                           Margin="16,8"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource PdaSecondaryTextBrush}" />
                <StackPanel x:Name="BodyPanel"
                            Margin="16,8,16,24" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing"
                      Width="48"
                      Height="48"
                      IsActive="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
