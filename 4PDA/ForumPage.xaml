<Page
    x:Class="_4PDA.ForumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource PdaPageBackgroundBrush}">
        <ListView x:Name="TopicsListView"
                  Padding="0,4,0,6"
                  Background="{ThemeResource PdaPageBackgroundBrush}"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemClick="TopicsListView_ItemClick"
                  Loaded="TopicsListView_Loaded">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ListViewItemPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0"
                                    SelectedBackground="Transparent"
                                    SelectedForeground="{ThemeResource PdaTextBrush}"
                                    PointerOverBackground="{ThemeResource PdaPageBackgroundBrush}"
                                    PressedBackground="{ThemeResource PdaPageBackgroundBrush}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="58"
                          Padding="8,7,12,7"
                          Background="{ThemeResource PdaPageBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0"
                                   Fill="{ThemeResource SystemControlHighlightAccentBrush}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding MarkerGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,0,1">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PdaTextBrush}" />

                            <TextBlock Text="{Binding Description}"
                                       Visibility="{Binding DescriptionVisibility}"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PdaSecondaryTextBrush}" />

                            <TextBlock Text="{Binding MetaText}"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PdaTertiaryTextBrush}" />

                            <TextBlock Text="{Binding ExtraText}"
                                       Visibility="{Binding ExtraVisibility}"
                                       Margin="0,1,0,0"
                                       FontSize="11"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PdaTertiaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Grid Height="56">
                    <ProgressRing x:Name="LoadMoreRing"
                                  Width="30"
                                  Height="30"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                </Grid>
            </ListView.Footer>
        </ListView>

        <ProgressRing x:Name="LoadingRing"
                      Width="44"
                      Height="44"
                      IsActive="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

        <TextBlock x:Name="EmptyTextBlock"
                   Visibility="Collapsed"
                   Text="Темы не загружены"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{ThemeResource PdaSecondaryTextBrush}" />
    </Grid>
</Page>
